---
import Container from "../layouts/Container.astro"
import Progress from "./Progress.astro";
import { Icon } from "astro-icon/components";

---

<section class="w-full relative overflow-hidden">
    <Container hook="#">
        <div class="w-full flex relative z-10">
            <div class="absolute md:hidden -right-10 bottom-0 top-16 md:top-0 md:relative md:right-0 py-6 pointer-events-none select-none z-0">
                <img 
                    src="/img/latin_idle.webp" 
                    alt=""
                    class="h-120 md:h-auto md:w-full md:max-w-xs object-contain opacity-30 md:opacity-100 drop-shadow-[0_0_35px_rgba(6,182,212,0.25)] transition-opacity ml-auto"
                >
            </div>
            <div class="w-full max-w-md lg:max-w-2xl m-auto flex flex-col justify-center md:justify-start mt-6 mb-10 md:mb-0 md:mt-20 relative z-10">
                <p class="font-monospace text-latland-accent uppercase text-base text-center md:text-left">
                    Temporada 1.5 | El Vástago del Norte
                </p>
                <h2 class="mt-4 font-body text-latland-text text-4xl lg:text-5xl text-center md:text-left">
                    Vuelve a Fuerte Nevado para reclamar lo que es nuestro por derecho
                </h2>
                <p class="mt-2 font-normal text-latland-text-muted text-center md:text-left">
                    El nuevo Rey convoca nuevos exploradores para recuperar lo perdido. <br>
                    Minecraft 26.2
                </p>
                <div class="flex flex-col md:flex-row gap-4 md:gap-2 mt-4 items-center max-w-xs self-center md:max-w-none md:self-auto">
                    <button class="bg-latland-card px-6 py-2 inline-flex gap-2 items-center justify-center text-sm lg:text-lg border-latland-border
                    border-[0.5px] rounded-lg hover:bg-latland-card/80 hover:border-latland-accent-dark hover:cursor-pointer
                    transition-colors duration-100 w-full md:w-fit">
                        <Icon name="mdi:minecraft" size={16} class={"text-latland-online"}/>
                        <p class="font-mono text-latland-accent-text">IP: Próximamente</p>
                        <Icon name="mdi:content-copy" size={16} class={"text-latland-text-secondary hidden"}/>
                    </button>
                    <a href="https://cafecito.app/latin235" class="bg-latland-accent text-gray-900 px-6 py-2 flex items-center w-full md:w-fit
                    rounded-lg hover:bg-latland-accent-dark border-latland-accent border-[0.5px] transition-colors hover:text-latland-text
                    justify-center">
                        Apoya el proyecto
                    </a>
                </div>
                
            </div>
            <!-- Render Skin -->
            <div class="hidden md:relative md:right-0 md:w-full md:flex justify-end py-6 pointer-events-none select-none z-0">
                <img src="/img/latin_idle.webp" alt=""
                class="h-90 md:h-auto md:w-full md:max-w-xs object-contain opacity-35 md:opacity-100 drop-shadow-[0_0_35px_rgba(6,182,212,0.25)] transition-opacity">
            </div>
        </div>
        <div class="flex lg:my-12 z-10 py-6">
            <Progress/>
        </div>
    </Container>
</section>
