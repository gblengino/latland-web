---
import Item from "./Item.astro"
import { Icon } from 'astro-icon/components'

const {navItems} = Astro.props
---

<div id="menu" class="sticky top-0 z-40 w-full h-16 flex items-center justify-end">
    <nav class="h-auto flex justify-between items-center">
        <section class="w-[40vw] hidden lg:flex lg:justify-end items-center">
            {
                navItems.map(item => (
                    <Item id="item" label={item.title} href={item.href} 
                    class="px-2 font-interface text-latland-text hover:text-latland-accent hover:drop-shadow-lg hover:drop-shadow-latland-accent-dark"/>
                ))
            }
        </section>
    </nav>
    <button id="open-nav-button" type="button" class="lg:hidden h-12 w-12 flex items-center justify-center text-latland-text -mt-1" 
    aria-label="Navigation">
        <Icon name='mdi:hamburger-menu' class="size-8"/>
    </button>
</div>