---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogLayout title={post.data.title} description={post.data.description}>
  <a href="/blog" class="inline-flex items-center gap-2 text-xs md:text-sm font-mono text-latland-text-secondary hover:text-latland-accent transition-colors mb-6 group">
    <span class="transition-transform group-hover:-translate-x-1">←</span>
    Volver al Blog
  </a>
  <article class="min-h-[75vh]">
    {post.data.heroImage && (
      <div class="aspect-21/9 w-full overflow-hidden mb-8">
        <Image
          src={post.data.heroImage}
          alt={post.data.title}
          width={1200}
          height={514}
          format="webp"
          quality={80}
          loading="eager"
          class="object-cover w-full h-full"
        />
      </div>
    )}

    <p class="font-mono text-xs md:text-sm text-latland-accent mb-2">
      {post.data.pubDate.toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}
    </p>
    <h1 class="font-body text-latland-text text-4xl lg:text-5xl mb-6">
      {post.data.title}
    </h1>
    <div class="markdown-content max-w-none text-latland-text font-sans leading-relaxed text-base md:text-xl">
      <Content />
    </div>
  </article>
  <div class="mt-12 pt-8 border-t border-latland-border flex justify-between items-center">
  <a href="/blog" class="inline-flex items-center gap-2 font-mono text-sm text-latland-accent hover:underline">
    ← Ver todas las noticias
  </a>
</div>
</BlogLayout>
